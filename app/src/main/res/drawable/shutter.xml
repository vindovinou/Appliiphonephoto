<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="@color/white" /></shape></item>
            <item android:inset="10dp"><shape android:shape="oval"><solid android:color="#FFBDBDBD" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="@color/white" /></shape></item>
            <item android:inset="8dp"><shape android:shape="oval"><solid android:color="@color/white" /></shape></item>
        </layer-list>
    </item>
</selector>
